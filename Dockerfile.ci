# ============================================================
# EasyTier CI Dockerfile — optimized layer caching
# Layer 1: Install system deps + download crate registry
# Layer 2: Fetch all dependencies (cached if Cargo.lock unchanged)
# Layer 3: Build project (only this layer reruns on source change)
# ============================================================

FROM registry.sakurapuare.com/dockerhub/library/rust:1.97-alpine AS builder
RUN apk add --no-cache musl-dev protobuf-dev pkgconfig openssl-dev openssl-libs-static perl make \
    clang-dev clang-static llvm-dev
ENV LIBCLANG_PATH=/usr/lib/llvm22/lib
ENV LIBCLANG_STATIC=1
WORKDIR /src

# Copy workspace manifests for dependency fetching
COPY Cargo.toml Cargo.lock ./
COPY easytier/Cargo.toml easytier/Cargo.toml
COPY easytier-core/Cargo.toml easytier-core/Cargo.toml
COPY easytier-proto/Cargo.toml easytier-proto/Cargo.toml
COPY easytier-contrib/Cargo.toml easytier-contrib/Cargo.toml
COPY easytier-web/Cargo.toml easytier-web/Cargo.toml

# Create dummy src files so cargo can resolve the workspace
RUN mkdir -p easytier/src easytier-core/src easytier-proto/src easytier-contrib/src easytier-web/src \
    && echo "" > easytier/src/lib.rs \
    && echo "fn main(){}" > easytier/src/main.rs \
    && echo "" > easytier-core/src/lib.rs \
    && echo "" > easytier-proto/src/lib.rs \
    && echo "" > easytier-contrib/src/lib.rs \
    && echo "" > easytier-web/src/lib.rs

# Fetch and build dependencies (cached if Cargo.lock unchanged)
RUN cargo build --release --target x86_64-unknown-linux-musl \
    --features=jemalloc -p easytier 2>/dev/null || true
# Remove dummy build artifacts but keep dependency artifacts
RUN rm -rf target/x86_64-unknown-linux-musl/release/deps/easytier* \
    target/x86_64-unknown-linux-musl/release/deps/libeasytier* \
    target/x86_64-unknown-linux-musl/release/.fingerprint/easytier* \
    target/x86_64-unknown-linux-musl/release/easytier*

# Now copy real source and build
COPY . .
RUN cargo build --release --target x86_64-unknown-linux-musl \
    --features=jemalloc -p easytier \
    && strip target/x86_64-unknown-linux-musl/release/easytier-core \
              target/x86_64-unknown-linux-musl/release/easytier-cli

# Runtime image
FROM registry.sakurapuare.com/dockerhub/library/alpine:latest
RUN apk add --no-cache tzdata tini
WORKDIR /app
COPY --from=builder /src/target/x86_64-unknown-linux-musl/release/easytier-core /usr/local/bin/
COPY --from=builder /src/target/x86_64-unknown-linux-musl/release/easytier-cli /usr/local/bin/
ENV TZ=Asia/Shanghai
EXPOSE 11010/tcp 11010/udp 11011/udp 11011/tcp 11012/tcp
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=5 \
    CMD ["/usr/local/bin/easytier-cli", "--rpc-portal", "127.0.0.1:15888", "--output", "json", "node", "info"]
ENTRYPOINT ["/sbin/tini", "--", "easytier-core"]
