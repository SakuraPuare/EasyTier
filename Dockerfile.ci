# ============================================================
# EasyTier CI Dockerfile
# Uses BuildKit cache mount for cargo registry + target dir
# to avoid re-downloading/re-compiling unchanged dependencies.
# ============================================================

FROM registry.sakurapuare.com/dockerhub/library/rust:1.97-alpine AS builder
RUN apk add --no-cache musl-dev protobuf-dev pkgconfig openssl-dev openssl-libs-static perl make \
    clang-dev clang-static llvm-dev
ENV LIBCLANG_PATH=/usr/lib/llvm22/lib
ENV LIBCLANG_STATIC=1
WORKDIR /src

COPY . .

RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/src/target \
    cargo build --release --target x86_64-unknown-linux-musl \
    --features=jemalloc -p easytier \
    && cp target/x86_64-unknown-linux-musl/release/easytier-core /tmp/ \
    && cp target/x86_64-unknown-linux-musl/release/easytier-cli /tmp/ \
    && strip /tmp/easytier-core /tmp/easytier-cli

FROM registry.sakurapuare.com/dockerhub/library/alpine:latest
RUN apk add --no-cache tzdata tini
WORKDIR /app
COPY --from=builder /tmp/easytier-core /usr/local/bin/
COPY --from=builder /tmp/easytier-cli /usr/local/bin/
ENV TZ=Asia/Shanghai
EXPOSE 11010/tcp 11010/udp 11011/udp 11011/tcp 11012/tcp
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=5 \
    CMD ["/usr/local/bin/easytier-cli", "--rpc-portal", "127.0.0.1:15888", "--output", "json", "node", "info"]
ENTRYPOINT ["/sbin/tini", "--", "easytier-core"]
